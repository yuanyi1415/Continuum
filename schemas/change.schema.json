{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContinuumChange",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "change_id": { "type": "string", "pattern": "^chg_" },
    "title": { "type": "string", "minLength": 1 },
    "intent": { "type": "string" },
    "status": { "enum": ["active", "closed", "superseded"] },
    "created_at": { "type": "string", "format": "date-time" },
    "closed_at": { "type": "string", "format": "date-time" },
    "superseded_by": { "type": "string", "pattern": "^chg_" },
    "spec_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" } },
    "ticket_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" } }
  },
  "required": ["schema_version", "change_id", "title", "status", "created_at", "spec_refs", "ticket_refs"]
}
