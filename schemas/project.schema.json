{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContinuumProject",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "identity"
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "name",
    "created_at",
    "repository"
  ]
}
