{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContinuumCurrentPointer",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^snap_"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "snapshot_id",
    "updated_at"
  ]
}
