{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContinuumSnapshot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "baselines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repository_identity": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "repository_identity",
          "revision"
        ]
      }
    },
    "stage": {
      "type": "string"
    },
    "active_changes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "next_gate": {
      "type": "string"
    },
    "last_reconcile": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "project_id",
    "created_at",
    "baselines",
    "active_changes",
    "blockers"
  ]
}
