{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContinuumArtifactRef",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "context",
        "adr",
        "spec",
        "ticket",
        "review",
        "evidence",
        "document",
        "other"
      ]
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "type",
    "authority",
    "locator"
  ]
}
