{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContinuumChange",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "closed",
        "superseded"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "superseded_by": {
      "type": "string"
    },
    "spec_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "ticket_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "change_id",
    "title",
    "status",
    "created_at",
    "spec_refs",
    "ticket_refs"
  ]
}
